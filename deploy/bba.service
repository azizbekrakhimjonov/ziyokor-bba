[Unit]
Description=Ziyokor BBA (Django + Gunicorn) — ziyokortest.uz
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ziyokor-bba
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ziyokor-bba/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:7583 --workers 2 --threads 4 --timeout 120
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
