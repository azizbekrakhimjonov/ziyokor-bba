[Unit]
Description=Ziyokor BBA (TanStack Start / Nitro)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ziyokor-bba
EnvironmentFile=/opt/ziyokor-bba/.env
ExecStart=/usr/bin/node /opt/ziyokor-bba/.output/server/index.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
